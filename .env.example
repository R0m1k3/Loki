# ── Loki — configuration du build/run Docker ────────────────────────────
# (fork d'AJEAN : https://github.com/nathaninline/ajean)

# Port de l'interface web (identique dedans/dehors).
LOKI_WEB_PORT=8090

# Optionnel — semé au PREMIER démarrage seulement (modifiable ensuite dans
# l'UI, qui garde la main) :
# Modèle initial : nom d'un .gguf présent dans ./models ou chemin complet.
LOKI_MODEL=
# Taille de contexte (défaut moteur : 32768)
LOKI_CTX=
# Couches déportées sur le GPU (défaut : 999 = tout)
LOKI_NGL=
